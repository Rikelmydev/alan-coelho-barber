# Copie para .env (no computador) ou cadastre na Vercel (Settings > Environment Variables).

# Senha do painel /admin
ADMIN_PASSWORD=
# Texto aleatório longo usado para assinar o login (qualquer sequência, ex.: gere em https://www.uuidgenerator.net)
ADMIN_SECRET=

# Banco de dados em produção (Turso). No computador, pode deixar vazio: usa data/agenda.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
