# Copie para .env (no computador) ou cadastre na Vercel (Settings > Environment Variables).

# Senha do painel /admin (obrigatória para usar o painel)
ADMIN_PASSWORD=

# Opcional: texto aleatório longo para assinar o login. Sem ele, usa a própria senha.
ADMIN_SECRET=

# Banco de dados em produção (Turso). A integração do Turso na Vercel preenche sozinha.
# No computador, pode deixar vazio: usa o arquivo data/agenda.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
