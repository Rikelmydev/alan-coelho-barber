---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-700 py-12">
  <div class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <Logo />
    <p class="text-sm text-mist">&copy; {year} {site.name}. Todos os direitos reservados.</p>
  </div>
</footer>
