---
interface Props {
  size?: "sm" | "lg";
  class?: string;
}
const { size = "sm", class: className = "" } = Astro.props;
const lg = size === "lg";
---

<span class:list={["inline-flex items-center gap-3", className]}>
  <span
    aria-hidden="true"
    class:list={[
      "grid shrink-0 place-items-center border border-gold-500/70 font-display italic text-gold-300",
      lg ? "size-14 text-xl" : "size-10 text-[0.95rem]",
    ]}
  >
    AC
  </span>
  <span class="flex flex-col leading-none">
    <span class:list={["font-display font-semibold text-bone", lg ? "text-2xl" : "text-lg"]}>Alan Coelho</span>
    <span class:list={["mt-1 font-sans font-medium tracking-[0.42em] text-gold-400 uppercase", lg ? "text-xs" : "text-[0.62rem]"]}>
      Barber
    </span>
  </span>
</span>
