---
// Barra fixa de agendamento no mobile: aparece depois que o hero sai da tela.
import BookingLink from "./BookingLink.astro";
---

<div
  id="booking-bar"
  data-visible="false"
  class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-ink-700 bg-ink-950/90 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] backdrop-blur-md transition-transform duration-500 ease-(--ease-luxe) data-[visible=true]:translate-y-0 md:hidden"
>
  <BookingLink class="w-full" />
</div>
