---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import { featuredService, serviceGroups } from "../data/content";
import { whatsappUrl } from "../data/site";
import BookingLink from "./BookingLink.astro";
---

<section id="servicos" class="relative bg-ink-900 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="max-w-2xl" data-reveal>
      <h2 class="font-display text-4xl leading-tight font-medium text-bone sm:text-5xl">Serviços</h2>
      <p class="mt-4 text-base leading-relaxed text-mist sm:text-lg">
        Toque no serviço para agendar direto, com horário confirmado na hora.
      </p>
    </header>

    <!-- Destaque com foto + tabela de preços. Mobile: um embaixo do outro. -->
    <div class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-14">
      <article
        class="service-card group relative flex min-h-[24rem] flex-col justify-end overflow-hidden border border-gold-500/30 p-7 sm:min-h-[28rem] sm:p-9 lg:col-span-5 lg:min-h-full"
        data-reveal
      >
        <Picture
          src={featuredService.image}
          alt={featuredService.imageAlt}
          inferSize
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 40vw, 100vw"
          formats={["webp"]}
          fallbackFormat="jpg"
          quality={72}
          class="absolute inset-0 -z-10 size-full object-cover grayscale-[40%] transition-transform duration-[1.2s] ease-(--ease-luxe) group-hover:scale-105"
        />
        <div class="absolute inset-0 -z-10 bg-linear-to-t from-ink-950 via-ink-950/70 to-ink-950/10"></div>

        <span class="mb-auto self-start border border-gold-400/60 bg-ink-950/60 px-3 py-1.5 text-xs font-semibold tracking-[0.14em] text-gold-300 uppercase backdrop-blur-sm">
          Combo
        </span>

        <h3 class="mt-10 font-display text-3xl font-medium text-bone sm:text-4xl">{featuredService.name}</h3>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-bone/80 sm:text-base">{featuredService.description}</p>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <p class="flex items-baseline gap-4">
            <span class="font-display text-3xl text-gold-300">{featuredService.price}</span>
            <span class="flex items-center gap-1.5 text-sm text-mist">
              <Icon name="ph:clock-light" class="size-4" aria-hidden="true" />{featuredService.duration}
            </span>
          </p>
          <BookingLink service={featuredService.id} />
        </div>
      </article>

      <div class="flex flex-col gap-12 lg:col-span-7">
        {
          serviceGroups.map((group, g) => (
            <div data-reveal style={`--d:${g * 120 + 80}ms`}>
              <h3 class="font-display text-2xl text-gold-300">{group.title}</h3>
              <ul class="mt-4 grid grid-cols-1 gap-x-10 sm:grid-cols-2">
                {group.items.map((s) => (
                  <li>
                    <a
                      href={whatsappUrl}
                      data-booking-open
                      data-booking-service={s.id}
                      class="menu-row group flex min-h-16 items-center gap-3 py-3"
                      aria-label={`Agendar ${s.name}, ${s.price}, ${s.duration}`}
                    >
                      <span class="flex min-w-0 flex-col">
                        <span class="text-base font-medium text-bone transition-colors duration-300 group-hover:text-gold-200">
                          {s.name}
                        </span>
                        <span class="mt-0.5 text-sm text-mist">{s.duration}</span>
                      </span>
                      <span aria-hidden="true" class="mb-1.5 flex-1 self-end border-b border-dotted border-ink-600" />
                      <span class="font-display text-xl whitespace-nowrap text-gold-300">{s.price}</span>
                      <Icon
                        name="ph:arrow-right-light"
                        class="hidden size-5 shrink-0 -translate-x-1 text-gold-400 opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:opacity-100 lg:block"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .service-card {
    transition:
      transform 0.5s var(--ease-luxe),
      border-color 0.5s var(--ease-luxe),
      box-shadow 0.5s var(--ease-luxe);
  }
  @media (hover: hover) {
    .service-card:hover {
      transform: translateY(-6px);
      border-color: rgb(216 184 114 / 0.65);
      box-shadow:
        0 24px 50px -24px rgb(194 155 78 / 0.45),
        inset 0 1px 0 rgb(244 230 192 / 0.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-card:hover {
      transform: none;
    }
  }
</style>
