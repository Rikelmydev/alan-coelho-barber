---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Gallery from "../components/Gallery.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import MobileBookingBar from "../components/MobileBookingBar.astro";
import BookingApp from "../components/booking/BookingApp";
---

<Layout>
  <!-- Marcador invisível: quando sai da tela, o cabeçalho ganha fundo -->
  <div id="top-sentinel" aria-hidden="true" class="pointer-events-none absolute top-0 h-20 w-px"></div>
  <Header />
  <main>
    <Hero />
    <Services />
    <Gallery />
    <Contact />
  </main>
  <Footer />
  <MobileBookingBar />
  <!-- Fluxo de agendamento: carrega depois que a página fica ociosa -->
  <BookingApp client:idle />
</Layout>
